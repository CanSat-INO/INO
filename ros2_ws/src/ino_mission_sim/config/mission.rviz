Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 35; 35; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Marker
      Name: Simulator truth - CanSat
      Enabled: true
      Topic:
        Value: /mission/robot_marker
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 10
    - Class: rviz_default_plugins/Path
      Name: Simulator truth - flight and ground path
      Enabled: true
      Topic:
        Value: /mission/truth/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 40; 210; 255
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Buffer Length: 1
    - Class: rviz_default_plugins/Image
      Name: Legacy camera input - left camera
      Enabled: true
      Topic:
        Value: /raw/left/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 4
        Y: 0
        Z: 2
Window Geometry:
  Width: 1200
  Height: 800
