* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# Preserve geometry bytes and avoid CRLF conversion / huge text merge conflicts.
*.obj -text
*.stl -text
*.png -text
*.jpg -text
*.zip -text
